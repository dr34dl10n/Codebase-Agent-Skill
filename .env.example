# ── Database ────────────────────────────────────────────────────────────────
#
# Database mode: "local" (default) or "docker"
#
# Local PostgreSQL — requires PG 15+ installed, sudo access:
#   CODEINDEX_DB_MODE=local
#   CODEINDEX_DB_HOST=localhost
#   CODEINDEX_DB_PORT=5432
#   CODEINDEX_DB_NAME=codeindex
#   CODEINDEX_DB_USER=codeindex
#   CODEINDEX_DB_PASSWORD=CHANGE_ME
#
# Docker PostgreSQL (pgvectordb) — requires Docker + docker compose:
#   CODEINDEX_DB_MODE=docker
#   CODEINDEX_DB_HOST=localhost
#   CODEINDEX_DB_PORT=5433
#   CODEINDEX_DB_NAME=codebase
#   CODEINDEX_DB_USER=postgres
#   CODEINDEX_DB_PASSWORD=CHANGE_ME   # deploy.sh --docker auto-generates if not set
#
# Password resolution order (never uses hardcoded insecure defaults):
#   1. CODEINDEX_DB_PASSWORD in environment (shell / ~/.hermes/.env / .env)
#   2. Password passed as CLI argument to deploy.sh
#   3. Interactive prompt (local mode) or auto-generated (docker mode)
#
# Quick start:
#   bash deploy.sh              # local PG, prompts for password
#   bash deploy.sh --docker     # Docker PG, reuses existing password or generates one
#
CODEINDEX_DB_MODE=local
CODEINDEX_DB_HOST=localhost
CODEINDEX_DB_PORT=5432
CODEINDEX_DB_NAME=codeindex
CODEINDEX_DB_USER=codeindex
CODEINDEX_DB_PASSWORD=CHANGE_ME

# Docker pgvectordb repo path (only relevant when CODEINDEX_DB_MODE=docker)
# CODEINDEX_DOCKER_REPO=/data/docker-pgvectordb

# ── Embeddings ──────────────────────────────────────────────────────────────
#
# Default: modernbert-embed-base (sentence-transformers backend)
# Auto-downloads from HuggingFace — no external service needed.
#
# Run `python scripts/detect_model.py --write-env` to auto-detect the best model
# for your hardware. It will write CODEINDEX_EMBED_MODEL to this file.
#
# Available models (sentence-transformers — zero external deps):
#   modernbert-embed-base   – 768-dim, 8192 ctx – DEFAULT, CPU-friendly, zero config
#   modernbert-embed-large  – 1024-dim, 8192 ctx – better quality, more RAM
#
# Advanced (Ollama backend — requires running Ollama server):
#   nomic-embed-text         – 768-dim, ~8k ctx – optional, for GPU servers with Ollama
#
# Backend is auto-detected from model name:
#   modernbert-* → sentence_transformers
#   nomic-*      → ollama
#
#CODEINDEX_EMBED_MODEL=modernbert-embed-base
#CODEINDEX_EMBED_BACKEND=sentence_transformers
CODEINDEX_EMBED_API_BASE=http://localhost:11434

# ── API server ──────────────────────────────────────────────────────────────
# (optional — for FastAPI endpoints)
CODEINDEX_API_HOST=127.0.0.1
CODEINDEX_API_PORT=8900